{
  "name": "llano-selecta-dealer-pos-and-inventory-system",
  "version": "1.0.0",
  "description": "Complete POS and Inventory System for Llano Selecta Dealer (Valencia, San Fernando, Cabanglasan)",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm run build --prefix client",
    "build:server": "npm run build --prefix server",
    "build": "npm run build:server && npm run build:client",
    "start": "npm run start --prefix server",
    "test": "npm run test --prefix server",
    "prisma:generate": "npm run prisma:generate --prefix server",
    "prisma:push": "npm run prisma:push --prefix server",
    "prisma:seed": "npm run prisma:seed --prefix server",
    "setup": "npm run prisma:generate && npm run prisma:safe-sync && npm run prisma:bootstrap",
    "prisma:safe-sync": "npm run prisma:safe-sync --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "main": "index.js",
  "dependencies": {
    "ansi-regex": "^5.0.1",
    "ansi-styles": "^4.3.0",
    "chalk": "^4.1.2",
    "cliui": "^8.0.1",
    "color-convert": "^2.0.1",
    "color-name": "^1.1.4",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "emoji-regex": "^8.0.0",
    "escalade": "^3.2.0",
    "express": "^5.3.0",
    "get-caller-file": "^2.0.5",
    "has-flag": "^4.0.0",
    "is-fullwidth-code-point": "^3.0.0",
    "pg": "^8.23.1",
    "require-directory": "^2.1.1",
    "rxjs": "^7.8.2",
    "shell-quote": "^1.12.0",
    "string-width": "^4.2.3",
    "strip-ansi": "^6.0.1",
    "supports-color": "^8.1.1",
    "tree-kill": "^1.2.2",
    "tslib": "^2.8.1",
    "wrap-ansi": "^7.0.0",
    "y18n": "^5.0.8",
    "yargs": "^17.7.2",
    "yargs-parser": "^21.1.1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
