# Llano Selecta Dealer POS and Inventory System Environment Configuration
DB_PROVIDER=sqlite
SQLITE_DATABASE_URL="file:./prisma/pos_local.db"
# Only needed when using `DB_PROVIDER=mysql`.
DATABASE_URL="mysql://root@127.0.0.1:3306/llano_selecta_db"
# Only needed for `DB_PROVIDER=turso` in production.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=
JWT_SECRET="replace-this-with-a-long-random-secret"
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"
UPLOAD_DIR="./uploads"
