{
  "name": "llano-selecta-dealer-pos",
  "version": 2,
  "installCommand": "npm run install:all",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "functions": {
    "api/index.js": {
      "includeFiles": ["server/uploads/login-bg-modern.jpg", "server/uploads/sample_freezer_barcode.png"],
      "regions": ["sin1"],
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
