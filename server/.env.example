# Local-first SQLite is the default. The database file is server/prisma/pos_local.db.
DB_PROVIDER=sqlite
SQLITE_DATABASE_URL="file:./prisma/pos_local.db"

# Only needed when DB_PROVIDER=mysql.
DATABASE_URL="mysql://root@127.0.0.1:3306/llano_selecta_db"

# Set these only for the deployed Turso database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BLOB_READ_WRITE_TOKEN=
JWT_SECRET="replace-this-with-a-long-random-secret"
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"
UPLOAD_DIR="./uploads"
